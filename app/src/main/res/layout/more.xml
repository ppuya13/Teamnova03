<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/view01"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:paddingLeft="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="더보기"
            android:textSize="25dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center_vertical"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/findbtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/find"/>
        <ImageView
            android:id="@+id/addchatbtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/addchat"/>
        <ImageView
            android:id="@+id/settingbtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/setting"/>
    </LinearLayout>

    <View
        android:id="@+id/wallet"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#fde500"
        app:layout_constraintTop_toBottomOf="@id/view01"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    />
    <View
        android:id="@+id/wallet_top"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintTop_toTopOf="@+id/wallet"
        app:layout_constraintLeft_toLeftOf="@+id/wallet"
        app:layout_constraintRight_toRightOf="@+id/wallet"
        />
    <View
        android:id="@+id/wallet_left"
        android:layout_width="20dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/wallet"
        app:layout_constraintLeft_toLeftOf="@id/wallet"
        app:layout_constraintBottom_toBottomOf="@id/wallet"/>
    <View
        android:id="@+id/wallet_right"
        android:layout_width="20dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/wallet"
        app:layout_constraintRight_toRightOf="@id/wallet"
        app:layout_constraintBottom_toBottomOf="@id/wallet" />
    <View
        android:id="@+id/wallet_bottom"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintLeft_toLeftOf="@id/wallet"
        app:layout_constraintRight_toRightOf="@id/wallet"
        app:layout_constraintBottom_toBottomOf="@id/wallet"/>
    <TextView
        android:id="@+id/wallet_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지갑"
        android:textSize="23dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:paddingLeft="5dp"
        app:layout_constraintTop_toBottomOf="@id/wallet_top"
        app:layout_constraintLeft_toRightOf="@id/wallet_left"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인증서"
        android:textSize="18dp"
        android:textColor="#000000"
        android:paddingTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/wallet_top"
        app:layout_constraintRight_toLeftOf="@id/wallet_right"
        app:layout_constraintTop_margin="100dp"
        />
    <ImageView
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:paddingTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/wallet_text"
        app:layout_constraintLeft_toRightOf="@id/wallet_left"
        app:layout_constraintRight_toLeftOf="@id/wallet_right"
        android:background="#ffffff"
        />



    <ImageButton
        android:id="@+id/btn05"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#f9f9f9"
        android:src="@drawable/adress"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btn06"
        />
    <ImageButton
        android:id="@+id/btn06"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#f9f9f9"
        android:src="@drawable/chatlist"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/btn05"
        app:layout_constraintRight_toLeftOf="@id/btn07"
        />
    <ImageButton
        android:id="@+id/btn07"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#f9f9f9"
        android:src="@drawable/viewlist"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/btn06"
        app:layout_constraintRight_toLeftOf="@id/btn08"
        />
    <ImageButton
        android:id="@+id/btn08"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#f9f9f9"
        android:src="@drawable/etc"
        app:layout_constraintWidth="match_constraint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/btn07"
        app:layout_constraintRight_toRightOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>